# Kopioi tämä tiedosto nimelle .env paikallista testausta varten.
# Vercelissä nämä lisätään Project Settings -> Environment Variables -kohtaan,
# EI tähän tiedostoon (.env ei koskaan mene GitHubiin, ks. .gitignore).

# Stripe-tilisi salainen avain (Dashboard -> Developers -> API keys).
# Käytä test-avainta (sk_test_...) kunnes olet valmis oikeaan rahaan.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Stripe-webhookin allekirjoitussalaisuus. Saat tämän kun luot webhookin
# Stripe Dashboardissa (Developers -> Webhooks -> Add endpoint), TAI
# paikallista testausta varten `stripe listen` -komennolla (Stripe CLI).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Diila-frontendin osoite, jonne asiakas/yritys ohjataan maksun jälkeen.
FRONTEND_URL=https://your-diila-site.example.com

# Kuinka monta prosenttia Diila pidättää itselleen jokaisesta asiakkaan
# maksamasta kupongista (Stripe Connect -maksuista). Esim. 10 = 10%.
PLATFORM_FEE_PERCENT=10
